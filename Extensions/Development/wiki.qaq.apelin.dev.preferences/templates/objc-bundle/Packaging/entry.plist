<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	PreferenceLoader's entry: the row Settings shows, and the bundle it opens
	from /Library/PreferenceBundles/<bundle>.bundle.
-->
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>bundle</key>
		<string>{{productName}}</string>
		<key>cell</key>
		<string>PSLinkCell</string>
		<key>detail</key>
		<string>{{productName}}RootListController</string>
		<key>isController</key>
		<true/>
		<key>label</key>
		<string>{{displayName}}</string>
	</dict>
</dict>
</plist>
