<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	A command-line tool run from a shell on a jailbroken device. Changing this
	file changes the build description, so under Confirm the next build is
	reviewed.

	platform-application: an ad-hoc signed executable without it is denied
	process inspection and much file access.
	no-sandbox: the tool works outside any container.
	storage.AppBundles and .AppDataContainers: roothide places the bootstrap
	inside an app container path; its developer notes require both.
	container-required = false: keeps the tool out of a per-binary data
	container, so HOME stays the real home of whoever ran it. Absence is not
	equivalent; the switch has to be explicitly false.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
</dict>
</plist>
