    "Prepare this project for distribution to %@: run check_distribution, fix everything it lists (the package's name, description, author and version, its identifiers, and the app's icon if it has one), then tell me what you changed. Do not build yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare this project for distribution to %@: run check_distribution, fix everything it lists (the package's name, description, author and version, its identifiers, and the app's icon if it has one), then tell me what you changed. Do not build yet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为分发到 %@ 准备这个项目：运行 check_distribution，修正它列出的所有问题（安装包的名称、描述、作者和版本、各个标识符，以及 App 的图标，如果有的话），然后告诉我你改了什么。先不要构建。"
          }
        }
      }
    },
