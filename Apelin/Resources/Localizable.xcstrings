    "Strict: asks before commands and sensitive changes. Relaxed: runs these operations without asking, within the app’s permissions. This setting applies to all chats." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strict: asks before commands and sensitive changes. Relaxed: runs these operations without asking, within the app’s permissions. This setting applies to all chats."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严格：执行命令和敏感更改前请求确认。宽松：在应用权限范围内直接执行，无需逐次确认。此设置适用于所有对话。"
          }
        }
      }
    },
