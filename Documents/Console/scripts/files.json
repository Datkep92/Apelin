{
  "name": "files: makes the Hello tweak project if it is missing (which takes the tweak extension and a registered toolchain and SDK); reads a project file by descriptor, and refuses a path out of the project, a protected edit of dpkg's records and a commit with a grant that was never given",
  "steps": [
    {"op": "hello", "label": "hello"},
    {"op": "projectCreate", "label": "project", "allowError": true,
     "request": {"templateID": "wiki.qaq.apelin.dev.tweak/objc-hook", "name": "Hello", "values": {}}},

    {"op": "fileRead", "label": "read", "request": {"scopeID": "project:Hello", "relativePath": "apelin-project.json"}},
    {"op": "expect", "request": {"step": "read", "path": "response.version.size", "exists": true}},
    {"op": "expect", "request": {"step": "read", "path": "response.descriptor.index", "equals": 0}},

    {"op": "fileRead", "label": "escape", "allowError": true, "request": {"scopeID": "project:Hello", "relativePath": "../../SDKs"}},
    {"op": "expect", "request": {"step": "escape", "ok": false}},

    {"op": "protectedEditOpen", "label": "refused", "allowError": true,
     "request": {"path": "${hello.response.installRoot}/var/lib/dpkg/status"}},
    {"op": "expect", "request": {"step": "refused", "errorCode": "denied"}},

    {"op": "protectedEditCommit", "label": "no-grant", "allowError": true, "request": {
      "grantID": "no-such-grant", "contentsBase64": "eA==",
      "expectedVersion": {"device": 0, "inode": 0, "size": 0, "modified": 0}
    }},
    {"op": "expect", "request": {"step": "no-grant", "errorCode": "notFound"}}
  ]
}
