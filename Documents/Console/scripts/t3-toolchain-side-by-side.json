{
  "name": "t3-toolchain-side-by-side",
  "steps": [
    {"op": "hello"},
    {"op": "toolchainStatus", "label": "before"},
    {"op": "expect", "request": {"step": "before", "path": "response.toolchains.0.version", "equals": "27.0"}},
    {"op": "expect", "request": {"step": "before", "path": "response.toolchains.1", "exists": false}},
    {"op": "sdkImport", "request": {"source": {"inbox": {"path": "iPhoneOS18.5.sdk"}}}, "label": "sdk", "timeoutSeconds": 1800},
    {"op": "expect", "request": {"step": "sdk", "state": "succeeded"}},
    {"op": "toolchainSetup", "request": {"source": {"appleCatalog": {"productID": "001-89745"}}, "components": ["c"]}, "label": "refused", "allowError": true},
    {"op": "expect", "request": {"step": "refused", "state": "failed"}},
    {"op": "toolchainSetup", "request": {"source": {"appleCatalog": {"productID": "082-41241"}}, "components": ["c"]}, "label": "setup", "timeoutSeconds": 3600},
    {"op": "expect", "request": {"step": "setup", "state": "succeeded"}},
    {"op": "toolchainStatus", "label": "both"},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.0.id", "equals": "${before.response.toolchains.0.id}"}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.version", "equals": "16.4"}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.newestSDK", "equals": "18.5"}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.packageID", "exists": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.components.0.selfCheckPassed", "equals": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.selfTests.0.passed", "equals": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.selfTests.1.passed", "equals": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.selfTests.2.passed", "equals": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.selfTests.3.passed", "equals": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.selfTests.4.passed", "equals": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.toolchains.1.selfTests.5.passed", "equals": true}},
    {"op": "expect", "request": {"step": "both", "path": "response.defaultID", "equals": "${before.response.defaultID}"}},
    {"op": "toolchainRemove", "request": {"id": "${both.response.toolchains.1.id}"}, "label": "remove", "timeoutSeconds": 600},
    {"op": "expect", "request": {"step": "remove", "state": "succeeded"}},
    {"op": "toolchainStatus", "label": "after"},
    {"op": "expect", "request": {"step": "after", "path": "response.toolchains.0.id", "equals": "${before.response.toolchains.0.id}"}},
    {"op": "expect", "request": {"step": "after", "path": "response.toolchains.1", "exists": false}},
    {"op": "expect", "request": {"step": "after", "path": "response.defaultID", "equals": "${before.response.defaultID}"}}
  ]
}
