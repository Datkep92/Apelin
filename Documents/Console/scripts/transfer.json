{
  "name": "transfer: needs a registered SDK; exports it as an .apesdk, reads the file back, and is refused importing it again here; refuses a file of another kind, an export of a toolchain and a project that do not exist, and a file outside Exports",
  "steps": [
    {"op": "hello"},
    {"op": "sdkList", "label": "sdks"},
    {"op": "expect", "request": {"step": "sdks", "path": "response.sdks.0.id", "exists": true}},

    {"op": "transferExport", "label": "export", "timeoutSeconds": 1800,
     "request": {"kind": "sdk", "id": "${sdks.response.sdks.0.id}", "createdBy": "Apelin console"}},
    {"op": "expect", "request": {"step": "export", "state": "succeeded"}},
    {"op": "expect", "request": {"step": "export", "path": "lastEvent.payload.result.export.exportedPath", "exists": true}},

    {"op": "transferInspect", "label": "inspect",
     "request": {"source": {"exported": {"path": "${export.lastEvent.payload.result.export.exportedPath}"}}}},
    {"op": "expect", "request": {"step": "inspect", "path": "response.summary.kind", "equals": "sdk"}},
    {"op": "expect", "request": {"step": "inspect", "path": "response.summary.id", "equals": "${sdks.response.sdks.0.id}"}},
    {"op": "expect", "request": {"step": "inspect", "path": "response.importable", "equals": false}},
    {"op": "expect", "request": {"step": "inspect", "path": "response.existingID", "equals": "${sdks.response.sdks.0.id}"}},

    {"op": "transferImport", "label": "again", "allowError": true,
     "request": {"source": {"exported": {"path": "sdk-${sdks.response.sdks.0.id}"}}, "kind": "sdk"}},
    {"op": "expect", "request": {"step": "again", "errorCode": "conflict"}},
    {"op": "transferImport", "label": "wrong-kind", "allowError": true,
     "request": {"source": {"exported": {"path": "sdk-${sdks.response.sdks.0.id}"}}, "kind": "toolchain"}},
    {"op": "expect", "request": {"step": "wrong-kind", "errorCode": "badRequest"}},

    {"op": "transferInspect", "label": "escape", "allowError": true,
     "request": {"source": {"exported": {"path": "../SDKs"}}}},
    {"op": "expect", "request": {"step": "escape", "ok": false}},
    {"op": "transferExport", "label": "no-toolchain", "allowError": true,
     "request": {"kind": "toolchain", "id": "no-such-toolchain"}},
    {"op": "expect", "request": {"step": "no-toolchain", "errorCode": "notFound"}},
    {"op": "transferExport", "label": "no-project", "allowError": true,
     "request": {"kind": "project", "id": "No Such Project"}},
    {"op": "expect", "request": {"step": "no-project", "errorCode": "notFound"}}
  ]
}
