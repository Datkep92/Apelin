{
  "name": "distribution",
  "steps": [
    {
      "op": "hello"
    },
    {
      "op": "distributionRepositoryList",
      "request": {
        "repositories": false
      },
      "label": "list"
    },
    {
      "op": "distributionRepositoryCreate",
      "request": {
        "name": "not a name!"
      },
      "label": "bad-name",
      "allowError": true
    },
    {
      "op": "expect",
      "request": {
        "step": "bad-name",
        "errorCode": "badRequest"
      }
    },
    {
      "op": "distributionRepositoryLink",
      "request": {
        "fullName": "no-owner"
      },
      "label": "bad-link",
      "allowError": true
    },
    {
      "op": "expect",
      "request": {
        "step": "bad-link",
        "errorCode": "badRequest"
      }
    },
    {
      "op": "distributionPublish",
      "request": {
        "files": [
          "/etc/hosts"
        ]
      },
      "label": "outside",
      "allowError": true
    },
    {
      "op": "expect",
      "request": {
        "step": "outside",
        "errorCode": "badRequest"
      }
    },
    {
      "op": "distributionRepositoryUnlink",
      "label": "unlink"
    },
    {
      "op": "distributionRepositoryList",
      "request": {
        "repositories": false
      },
      "label": "unlinked"
    },
    {
      "op": "expect",
      "request": {
        "step": "unlinked",
        "path": "response.linked",
        "equals": null
      }
    }
  ]
}
