{
  "name": "tool-host: needs the disassembler agent tool extension (wiki.qaq.apelin.agent-tools.disassembler) installed; opens it, lists some of dyld's symbols through it, closes it, and refuses an undeclared tool, a closed session and an extension that is not installed",
  "steps": [
    {"op": "hello"},
    {"op": "toolHostOpen", "label": "open", "request": {"id": "wiki.qaq.apelin.agent-tools.disassembler"}},
    {"op": "expect", "request": {"step": "open", "path": "response.tools.0.name", "exists": true}},

    {"op": "toolHostCall", "label": "symbols", "request": {
      "sessionID": "${open.response.sessionID}", "tool": "symbols",
      "arguments": {"binary": "/usr/lib/dyld", "kind": "defined", "filter": "dyld", "limit": 5},
      "timeoutSeconds": 30
    }},
    {"op": "expect", "request": {"step": "symbols", "path": "response.text", "exists": true}},

    {"op": "toolHostCall", "label": "undeclared", "allowError": true, "request": {
      "sessionID": "${open.response.sessionID}", "tool": "no-such-tool", "arguments": {}
    }},
    {"op": "expect", "request": {"step": "undeclared", "ok": false}},

    {"op": "toolHostClose", "request": {"sessionID": "${open.response.sessionID}"}},
    {"op": "toolHostClose", "label": "closed", "allowError": true, "request": {"sessionID": "${open.response.sessionID}"}},
    {"op": "expect", "request": {"step": "closed", "errorCode": "notFound"}},

    {"op": "toolHostOpen", "label": "missing", "allowError": true, "request": {"id": "wiki.qaq.apelin.agent-tools.missing"}},
    {"op": "expect", "request": {"step": "missing", "ok": false}}
  ]
}
