<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	apelin-agent, started by apelind's session host as mobile.
	One agent session. It reads the bundle and container of the app a tweak
	targets, as the app does, so it carries the same storage pair.

	keychain-access-groups: the provider credentials, Apelin's own items
	(service wiki.qaq.apelin.agent) in its own group, this device only and
	never synchronised. Nothing else shares the group; the credential inbox
	is read by this executable, so the item is written and read by the same
	signing identity. Unverified on a device (A2's keychain spike).

	Every system capability goes to the session host as a request; no UI,
	IOKit, logging or task-port key here.

	Never `wiki.qaq.apelin.client` and never the Mach-lookup of
	`wiki.qaq.apelin.service`: a worker reaches the session host only
	through the socketpair it was spawned with, and the packager refuses
	either key here. Add what the domain needs, with the reason, in this
	file only.
-->
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>wiki.qaq.apelin.agent</string>
	</array>
</dict>
</plist>
