<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	apelin-log-reader, started by apelind's session host as root, and only
	when apelin-diagnostics cannot read the live log as mobile.
	Reads the live unified log over a filter the session host checked.
	System libraries only.

	The logging keys: diagnosticd may still ask a root client for them
	(Packages/ApelinDiagnostics/README.md, "Root log read"; unverified on
	iOS). Nothing else — no UI, IOKit, task-port or storage key.

	Never `wiki.qaq.apelin.client` and never the Mach-lookup of
	`wiki.qaq.apelin.service`: a worker reaches the session host only
	through the socketpair it was spawned with, and the packager refuses
	either key here. Add what the domain needs, with the reason, in this
	file only.
-->
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.logging.stream</key>
	<true/>
	<key>com.apple.diagnosticd.stream</key>
	<true/>
</dict>
</plist>
