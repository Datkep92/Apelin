<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	apelin-environment, started by apelind's session host as mobile.
	Downloads, unpacks and retargets the toolchain, checks SDKs and runs the
	git service, all inside mobile's own folders.

	keychain-access-groups: the git service's HTTPS credentials, one per
	host (service wiki.qaq.apelin.git), in a group of their own that only
	this executable carries, this device only and never synchronised. The
	app sets and lists them through gitCredentialSet and gitSettings, so the
	item is written and read by the same signing identity, and no reply
	carries the token.

	Never `wiki.qaq.apelin.client` and never the Mach-lookup of
	`wiki.qaq.apelin.service`: a worker reaches the session host only
	through the socketpair it was spawned with, and the packager refuses
	either key here. Add what the domain needs, with the reason, in this
	file only.
-->
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>wiki.qaq.apelin.git</string>
	</array>
</dict>
</plist>
