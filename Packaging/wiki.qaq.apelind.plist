<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	apelind, Apelin's privileged backend. This fork starts it with the device
	and keeps it alive: no cold handshake when Apelin opens, and a daemon that
	exits is brought back by launchd. Its session host and workers are its
	children, in its process group, and go with it: no AbandonProcessGroup.
	The install prefix in ProgramArguments is substituted at package time:
	empty for roothide, whose launchctl puts the bootstrap root in front at
	every load, and /var/jb for rootless.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>wiki.qaq.apelind</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PREFIX@/usr/libexec/apelind</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<!-- 0022: files the daemon creates are not group- or world-writable. -->
	<key>Umask</key>
	<integer>18</integer>
	<!-- FORK-PERSONALISATION: persist-backend (owner, 2026-11-21).
	     Ready before the first chat, and brought back if it exits.
	     make check allows RunAtLoad/KeepAlive only with this marker.
	     Idle workers are still swept by the session host. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>MachServices</key>
	<dict>
		<key>wiki.qaq.apelin.service</key>
		<true/>
	</dict>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>10240</integer>
	</dict>
	<!-- Nothing may inject into the process that does privileged work. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>DISABLE_TWEAKS</key>
		<string>1</string>
	</dict>
</dict>
</plist>
