--swiftversion 6.2

# os.Logger builds its message in an autoclosure, so `self` inside a log
# interpolation is not redundant: the compiler requires it, and stripping it
# breaks the build. Tell redundantSelf which calls take one.
--selfrequired log,trace,debug,info,notice,warning,error,critical,fault

# vendored code keeps its upstream form; templates ship with pinned digests
# (Extensions/Development/*/manifest.json); generated code is written by its
# script (Packages/ApelinKit/Scripts/embed-schemas.py), not by hand
--exclude Packages/Runestone,Extensions/Development,Apelind/Vendor,Packages/ApelinKit/Sources/ApelinProject/JSON/EmbeddedSchemas.swift,**/.build,build
